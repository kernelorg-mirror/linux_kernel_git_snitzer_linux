# The four cells of the stripe to compare a setting by: both copies and both
# loans at sixteen connections, rings of 4 x 256 and a 1 MiB buffer but for
# the NVMe/TCP copy, which was fastest at 4 x 128 and 256 KiB.
#     PRP_DIR=/hs/stripe/zcbudget SGL_BACKING=/hs/stripe/zcbudget-nvmet.img \
#     STEP_JOBS=16 NULLB_MIB=16384 ./sweep.sh <outdir> plans/16k-12-stripe.plan
256 1048576 0 prp step-copy-n16
256 1048576 16 prp step-on-n16
128 262144 0 sgl step-copy-n16
256 1048576 16 sgl step-on-n16
