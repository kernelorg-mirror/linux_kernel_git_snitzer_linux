# The two copies of the hero ladder's first rung, to compare where nfsd is:
# the native drive's copy stops near 5 GB/s on little CPU where NVMe/TCP's
# passes 8.
#     STEP_JOBS=16 NULLB_MIB=16384 ./sweep.sh <outdir> plans/16k-8-profile.plan
# with nfsd-stacks.sh run 40 s into each cell.
128 262144 0 prp step-copy-n16
128 262144 0 sgl step-copy-n16
