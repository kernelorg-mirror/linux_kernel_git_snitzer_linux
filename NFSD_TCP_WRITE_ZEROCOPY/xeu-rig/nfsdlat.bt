#!/usr/bin/bpftrace
/*
 * nfsdlat.bt - where an nfsd thread's time goes in a WRITE and how far the
 * slow ones are from the rest: a whole RPC once it is received
 * (svc_process), the sending of its reply, the WRITE as nfsd sees it, the write into the file system (direct
 * or through the page cache) and the COMMIT, each as a histogram in
 * microseconds with a count of those over 10 ms; and who takes the fixed
 * receive region's lock.  Run it for a fixed time inside a cell:
 *     timeout -s INT 15 bpftrace nfsdlat.bt
 */
config = { missing_probes = "warn" }

fentry:sunrpc:svc_process { @t_p[tid] = nsecs; }
fexit:sunrpc:svc_process /@t_p[tid]/
{
	$d = (nsecs - @t_p[tid]) / 1000;
	@svc_process_us = hist($d);
	if ($d > 10000) { @over_10ms["svc_process"] = count(); }
	delete(@t_p, tid);
}

fentry:sunrpc:svc_tcp_sendto { @t_s[tid] = nsecs; }
fexit:sunrpc:svc_tcp_sendto /@t_s[tid]/
{
	$d = (nsecs - @t_s[tid]) / 1000;
	@reply_send_us = hist($d);
	if ($d > 10000) { @over_10ms["reply_send"] = count(); }
	delete(@t_s, tid);
}

fentry:nfsd:nfsd_write { @t_w[tid] = nsecs; }
fexit:nfsd:nfsd_write /@t_w[tid]/
{
	$d = (nsecs - @t_w[tid]) / 1000;
	@nfsd_write_us = hist($d);
	if ($d > 10000) { @over_10ms["nfsd_write"] = count(); }
	delete(@t_w, tid);
}

fentry:nfsd:nfsd_direct_write { @t_d[tid] = nsecs; }
fexit:nfsd:nfsd_direct_write /@t_d[tid]/
{
	$d = (nsecs - @t_d[tid]) / 1000;
	@direct_write_us = hist($d);
	if ($d > 10000) { @over_10ms["direct_write"] = count(); }
	delete(@t_d, tid);
}

fentry:vmlinux:iomap_dio_rw /comm == "nfsd"/ { @t_io[tid] = nsecs; }
fexit:vmlinux:iomap_dio_rw /@t_io[tid]/
{
	@iomap_dio_rw_us = hist((nsecs - @t_io[tid]) / 1000);
	delete(@t_io, tid);
}

fentry:nfsd:nfsd_commit { @t_c[tid] = nsecs; }
fexit:nfsd:nfsd_commit /@t_c[tid]/
{
	$d = (nsecs - @t_c[tid]) / 1000;
	@commit_us = hist($d);
	if ($d > 10000) { @over_10ms["commit"] = count(); }
	delete(@t_c, tid);
}

/* The region's one lock: who gives pages back to it and who takes them. */
fentry:vmlinux:page_pool_rx_region_put { @region_put[comm == "nfsd" ? "nfsd" : (comm == "swapper/0" ? "idle/softirq" : "other"), cpu < 8 ? "ring cpu" : "other cpu"] = count(); }
fentry:vmlinux:page_pool_rx_region_alloc { @region_alloc = count(); }

END { clear(@t_p); clear(@t_s); clear(@t_w); clear(@t_d); clear(@t_io); clear(@t_c); }
