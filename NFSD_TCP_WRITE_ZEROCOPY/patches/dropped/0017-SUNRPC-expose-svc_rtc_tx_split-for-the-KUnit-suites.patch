From acb791346c0bd708e7bebe51f70bba0e39bfca50 Mon Sep 17 00:00:00 2001
From: Mike Snitzer <snitzer@kernel.org>
Date: Mon, 16 Nov 2026 19:13:21 +0000
Subject: [PATCH] SUNRPC: expose svc_rtc_tx_split for the KUnit suites

The run-to-completion suite sets svc_rtc_tx_split around attaching a
fixture's connection, so that the connection is split and its send
work item can be tested.

Signed-off-by: Mike Snitzer <snitzer@kernel.org>
---
 include/linux/sunrpc/svc_xprt.h | 1 +
 net/sunrpc/svc_xprt.c           | 3 ++-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/include/linux/sunrpc/svc_xprt.h b/include/linux/sunrpc/svc_xprt.h
index 16426e09d226a..15adf079d07d8 100644
--- a/include/linux/sunrpc/svc_xprt.h
+++ b/include/linux/sunrpc/svc_xprt.h
@@ -341,6 +341,7 @@ enum svc_rtc_verdict svc_rtc_recv_step(struct svc_xprt *xprt,
 				       const struct svc_rtc_ops **opsp);
 bool	svc_rtc_thread_serve(struct svc_rqst *rqstp, struct svc_xprt *xprt);
 unsigned int svc_rtc_drain_sends(struct svc_rtc_conn *conn, bool dead);
+extern bool svc_rtc_tx_split;	/* latched by svc_rtc_xprt_attach() */
 int	svc_rtc_pick_cpu(const void *key, int rx_cpu,
 			 const struct cpumask *node,
 			 const struct cpumask *rxcpus,
diff --git a/net/sunrpc/svc_xprt.c b/net/sunrpc/svc_xprt.c
index 6f09c62863e70..6e35bf027d138 100644
--- a/net/sunrpc/svc_xprt.c
+++ b/net/sunrpc/svc_xprt.c
@@ -1740,7 +1740,8 @@ EXPORT_SYMBOL_IF_KUNIT(svc_rtc_place);
  * limited by one CPU doing all four.  Latched when a connection is
  * attached: a connection keeps the mode it started with.
  */
-static bool svc_rtc_tx_split __read_mostly;
+VISIBLE_IF_KUNIT bool svc_rtc_tx_split __read_mostly;
+EXPORT_SYMBOL_IF_KUNIT(svc_rtc_tx_split);
 module_param(svc_rtc_tx_split, bool, 0644);
 MODULE_PARM_DESC(svc_rtc_tx_split,
 		 "Run each connection's completions and sends on a second work item and CPU (applies to connections made after it is set)");
-- 
