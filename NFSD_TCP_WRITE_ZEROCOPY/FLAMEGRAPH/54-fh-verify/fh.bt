#!/usr/bin/env bpftrace
/*
 * Round 54: what repeats in fh_verify under load.  A look: its probes cost the
 * run.  Runs 8 s.  No kretprobe: bpftrace 0.26 joins a kprobe and a kretprobe of
 * one function into a session and runs the kprobe's body at both ends, never
 * the kretprobe's, which doubled every count here and read a clobbered arg5.
 */
kprobe:nfsd3_proc_write { @op["write"] = count(); }
kprobe:nfsd3_proc_commit { @op["commit"] = count(); }
kprobe:__fh_verify { @op["__fh_verify"] = count(); }
kprobe:xfs_iget { @op["xfs_iget"] = count(); }

kprobe:nfsd_set_fh_dentry
{
	/* fh_handle is first in struct svc_fh, fh_raw after an unsigned int. */
	$raw = (uint8 *)(arg5 + 4);
	$a = *(uint64 *)($raw + 0);
	$b = *(uint64 *)($raw + 8);
	$c = *(uint64 *)($raw + 16);
	$d = *(uint64 *)($raw + 24);
	$h = ($a * 0x9e3779b97f4a7c15) ^ ($b * 0xc2b2ae3d27d4eb4f) ^
	     ($c * 0x165667b19e3779f9) ^ ($d * 0x27d4eb2f165667c5);

	@op["set_fh_dentry"] = count();
	@fh_size = lhist(*(uint32 *)arg5, 0, 64, 4);
	@handles[$h] = count();
	@handle_cpus[$h, cpu] = count();

	@total = count();
	if (@last_global == $h) { @same["global last"] = count(); }
	@last_global = $h;
	if (@last_cpu[cpu] == $h) { @same["this CPU's last"] = count(); }
	@last_cpu[cpu] = $h;
	if (@last_tid[tid] == $h) { @same["this thread's last"] = count(); }
	@last_tid[tid] = $h;

	$seen = @seen[$h, cpu];
	if ($seen) { @gap_same_cpu_us = hist((nsecs - $seen) / 1000); }
	@seen[$h, cpu] = nsecs;
	$any = @seen_any[$h];
	if ($any) { @gap_any_cpu_us = hist((nsecs - $any) / 1000); }
	@seen_any[$h] = nsecs;
}

interval:s:8
{
	clear(@last_cpu); clear(@last_tid); clear(@seen); clear(@seen_any);
	clear(@last_global);
	exit();
}
