// wake-run.bt: round 83, the latency of a loaned record's next piece.
// @piece_us: from the svc_data_ready() that releases an incomplete loaned
// record (it finds sk_rx_want set and leaves XPT_DATA set) to the next
// tcp_read_sock() on that socket, whoever reads it.  @wake_*: for every
// wakeup of an nfsd thread, from sched_waking to its switch-in, by whether
// its target CPU was running the idle task at the wakeup.  Exits after 5 s.
fexit:sunrpc:svc_data_ready
{
	$svsk = (struct svc_sock *)args.sk->sk_user_data;
	if ($svsk != 0 && $svsk->sk_rx_want != 0 &&
	    ($svsk->sk_xprt.xpt_flags & (1 << 3)) != 0 &&
	    !has_key(@armed, args.sk)) {
		@armed[args.sk] = nsecs;
	}
}
fentry:vmlinux:tcp_read_sock /has_key(@armed, args.sk)/
{
	$us = ((uint64)nsecs - (uint64)@armed[args.sk]) / (uint64)1000;
	@piece_us = hist($us);
	@pieces = count();
	@piece_sum_us = sum($us);
	delete(@armed, args.sk);
}
tracepoint:sched:sched_waking /args.comm == "nfsd"/
{
	@wk[args.pid] = nsecs;
	@wk_idle[args.pid] = (@cur[args.target_cpu] == 0) ? 1 : 0;
}
tracepoint:sched:sched_switch
{
	@cur[cpu] = args.next_pid;
	if (args.next_comm == "nfsd" && has_key(@wk, args.next_pid)) {
		$ns = (uint64)nsecs - (uint64)@wk[args.next_pid];
		if (@wk_idle[args.next_pid]) {
			@wake_idle_us = hist($ns / (uint64)1000);
			@wake_idle_n = count(); @wake_idle_sum_ns = sum($ns);
		} else {
			@wake_busy_us = hist($ns / (uint64)1000);
			@wake_busy_n = count(); @wake_busy_sum_ns = sum($ns);
		}
		delete(@wk, args.next_pid);
		delete(@wk_idle, args.next_pid);
	}
}
interval:s:5
{
	clear(@armed); clear(@wk); clear(@wk_idle); clear(@cur);
	exit();
}
