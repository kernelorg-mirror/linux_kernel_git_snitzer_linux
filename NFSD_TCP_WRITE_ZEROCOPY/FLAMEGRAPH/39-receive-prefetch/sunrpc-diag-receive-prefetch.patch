+			struct svc_tcp_rx_rcv_lat __percpu *pcpu =
+				smp_load_acquire(&svc_tcp_rx_rcv_pcpu);
+			int diag = pcpu ? READ_ONCE(svc_tcp_rx_diag_rcv) : 0;
+			struct svc_tcp_rx_rcv_lat *l = NULL;
