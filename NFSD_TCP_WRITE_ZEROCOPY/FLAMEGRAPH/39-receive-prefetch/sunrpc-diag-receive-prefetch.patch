@@ -4148,14 +4360,34 @@ static int svc_tcp_recv_skb(read_descriptor_t *desc, struct sk_buff *skb,
 		if (remaining && state->mode == SVC_TCP_RX_MIXED) {
 			struct page *prev = state->region_last;
