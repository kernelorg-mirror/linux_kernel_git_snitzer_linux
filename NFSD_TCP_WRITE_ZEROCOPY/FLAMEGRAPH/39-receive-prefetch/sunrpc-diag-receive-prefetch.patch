+				l->sections++;
+				l->pages += need;
+				this_cpu_write(svc_tcp_rx_rcv_cur, NULL);
+				put_cpu_ptr(pcpu);
+			}
 
 			/* One lookup for the copy check and the admission. */
 			if (need && !state->credit_linked)
@@ -4653,6 +4885,7 @@ void svc_cleanup_xprt_sock(void)
 {
