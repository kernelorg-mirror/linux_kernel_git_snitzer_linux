#!/usr/bin/bpftrace
/*
 * hol.bt: when a data drive runs empty, where was the WRITE that next
 * fed it (FLAMEGRAPH round 99, the head-of-line question).
 *
 * A drive's depth is its requests issued and not completed (259:0 to
 * 259:7, a requeued request counted once, by device and sector), kept
 * per CPU and summed over the 64 at each completion: one count a drive,
 * += and -= from many CPUs at once, lost updates and drifted off zero
 * (hol-v1.bt, t2-r564: a tenth of inflight.py's empty time).  A gap
 * opens when the last completes (at g) and closes at the next issue.
 * The request's owner, the nfsd thread that queued its bio (else the
 * thread that issues it), is the one whose WRITE (W) refills the drive; W's record was read by that thread's transport (X):
 *
 *   first  nfs3svc_rx_target(): the record's first region skb read,
 *          the export's key named (the window's admit, at window > 0)
 *   full   svc_xdr_recvfrom: the whole record read
 *   proc   nfsd_direct_write() entered
 *
 * and, from X's record before W: when it was read in full (pfull) and
 * its key (the same export or another).  Each gap is classed by where W
 * stood at g:
 *
 *   A in nfsd, before its I/O        proc <= g
 *   B read, not yet writing          full <= g < proc
 *   C being read off its connection  first <= g < full
 *   D not begun; X still reading the record before it (pfull > g),
 *     D1 for another export, D2 for the same one: W behind it
 *   E not begun; X done with the record before it (pfull <= g): the
 *     client had not sent W, or no thread was reading X
 *   F the issue from a thread with no WRITE seen (kblockd, a record
 *     resumed on another thread, an unkeyed one)
 *
 * Classes print as 0 (A) to 6 (F), A B C D1 D2 E F; hol-read.py names them.
 * Printed: each class's gaps and their summed us (the share of the
 * drives' empty time), the gaps' lengths, for C to E how far W was from
 * g, and each drive's empty us over the span (against inflight.py).
 *     timeout -s INT 12 bpftrace hol.bt
 */
config = { missing_probes = "error"; max_map_keys = 262144 }

BEGIN { @t0 = nsecs; }

kprobe:sunrpc:svc_tcp_recvfrom
{
	$r = (struct svc_rqst *)arg0;
	@xp[tid] = (uint64)$r->rq_xprt;
}

kprobe:nfsd:nfs3svc_rx_target
/ has_key(@xp, tid) /
{
	$x = @xp[tid];
	if (!has_key(@first, $x)) { @first[$x] = (nsecs - @t0) / 1000; }
}

kretprobe:nfsd:nfs3svc_rx_target
/ has_key(@xp, tid) /
{
	@key[@xp[tid]] = (uint64)retval;
}

tracepoint:sunrpc:svc_xdr_recvfrom
/ has_key(@xp, tid) /
{
	$x = @xp[tid]; $t = (nsecs - @t0) / 1000;
	if (has_key(@first, $x)) {
		@rf[tid] = @first[$x]; @rl[tid] = $t; @rk[tid] = @key[$x];
		@rpf[tid] = has_key(@lfull, $x) ? @lfull[$x] : 0;
		@rpk[tid] = has_key(@lkey, $x) ? @lkey[$x] : 0;
		@lfull[$x] = $t; @lkey[$x] = @key[$x];
		delete(@first[$x]); delete(@key[$x]);
	} else {
		delete(@rf[tid]);
	}
}

kprobe:nfsd:nfsd_direct_write
/ has_key(@rf, tid) /
{
	@rp[tid] = (nsecs - @t0) / 1000;
}

kretprobe:nfsd:nfsd_direct_write
{
	delete(@rp[tid]); delete(@rf[tid]); delete(@rl[tid]); delete(@rk[tid]);
	delete(@rpf[tid]); delete(@rpk[tid]);
}

tracepoint:block:block_bio_queue
/ args.dev >= (259 << 20) && args.dev <= (259 << 20) + 7 && has_key(@rp, tid) /
{
	@own[args.dev, args.sector] = tid;
}

tracepoint:block:block_rq_issue
/ args.dev >= (259 << 20) && args.dev <= (259 << 20) + 7 /
{
	$d = args.dev; $s = args.sector;
	if (!has_key(@inq, ($d, $s))) {
		@inq[$d, $s] = 1;
		@dq[$d, cpu] += 1;
		if (has_key(@g, $d)) {
			$t = (nsecs - @t0) / 1000; $g = @g[$d]; $len = $t - $g; $c = 6;
			$o = has_key(@own, ($d, $s)) ? @own[$d, $s] : tid;
			@empty[$d - (259 << 20)] = sum($len);
			if (!has_key(@rp, $o)) {
				$c = 6;
			} else if (@rp[$o] <= $g) {
				$c = 0;
			} else if (@rl[$o] <= $g) {
				$c = 1;
			} else if (@rf[$o] <= $g) {
				$c = 2;
				@ahead["C: g .. read in full"] = hist(@rl[$o] - $g);
			} else if (@rpf[$o] > $g) {
				if (@rpk[$o] != @rk[$o]) {
					$c = 3;
				} else {
					$c = 4;
				}
				@ahead["D: g .. its first read"] = hist(@rf[$o] - $g);
				@ahead["D: g .. the record before it read"] = hist(@rpf[$o] - $g);
			} else {
				$c = 5;
				@ahead["E: g .. its first read"] = hist(@rf[$o] - $g);
				@ahead["E: the record before it read .. g"] = hist($g - @rpf[$o]);
			}
			@gaps[$c] = count(); @gap_us[$c] = sum($len);
			@len[$c] = hist($len);
			delete(@g[$d]);
		}
	}
}

tracepoint:block:block_rq_complete
/ args.dev >= (259 << 20) && args.dev <= (259 << 20) + 7 /
{
	$d = args.dev; $s = args.sector;
	if (has_key(@inq, ($d, $s))) {
		delete(@inq[$d, $s]); delete(@own[$d, $s]);
		@dq[$d, cpu] -= 1;
		$n = 0;
		for ($i : 0..64) { $n += @dq[$d, $i]; }
		if ($n <= 0 && !has_key(@g, $d)) { @g[$d] = (nsecs - @t0) / 1000; }
	}
}

END
{
	printf("traced_us %d\n", (nsecs - @t0) / 1000);
	clear(@xp); clear(@first); clear(@key); clear(@lfull); clear(@lkey);
	clear(@rf); clear(@rl); clear(@rk); clear(@rpf); clear(@rpk); clear(@rp);
	clear(@inq); clear(@dq); clear(@g); clear(@own);
}
