--- xeu-esdk-v2.0.1.orig/xeu_drv.c
+++ xeu-esdk-v2.0.1/xeu_drv.c
@@ -194,6 +194,136 @@
 MODULE_PARM_DESC(rx_prefetch,
 		 "prefetch the next received frame's headers, skb_shared_info and struct page while a frame is processed (default N)");
 
+/*
+ * DIAGNOSTIC (FLAMEGRAPH round 41, not for keeping): where GRO's misses
+ * are.  On one frame in gro_lat_every (0: off), just before the frame goes
+ * to napi_gro_receive(), each line GRO's first touches load is timed by
+ * the 1 GHz counter read after ISB, a DSB LD before and after the load:
+ *   0 own          a line of this CPU's own, just written: the floor
+ *   1 hdr2         the frame's second header line (the TCP header's end
+ *                  and options), which nothing in xeu reads
+ *   2 agg_cb       the held aggregate's NAPI_GRO_CB (its skb's cb)
+ *   3 agg_hdr      the aggregate's header line (p->data), which
+ *                  gro_list_prepare() and inet_gro_receive() compare
+ *   4 agg_shinfo   the aggregate's skb_shared_info (frag_list, gso_segs)
+ *   5 last_shinfo  the shared info of the aggregate's last skb, where
+ *                  skb_gro_receive() adds the frame, when it is not p
+ * The held aggregate is the first in the frame's GRO hash bucket, timed
+ * only when its hash is the frame's.  /sys/module/xeu/parameters/gro_lat
+ * prints n, sum_ns and a log2 histogram for each, with the frames sampled,
+ * those with no aggregate held and those whose bucket held another flow's;
+ * a write clears.
+ */
+#include <net/gro.h>
+
+#define XEU_GL_N 6
+struct xeu_gro_lat {
+	u64 n[XEU_GL_N], sum[XEU_GL_N], h[XEU_GL_N][16];
+	u64 sampled, none, other;
+	unsigned int tick;
+	u64 own[8] __aligned(64);
+};
+static DEFINE_PER_CPU(struct xeu_gro_lat, xeu_gro_lat);
+
+static unsigned int gro_lat_every;
+module_param(gro_lat_every, uint, 0644);
+MODULE_PARM_DESC(gro_lat_every, "DIAGNOSTIC: time GRO's lines on one frame in this many (0: off)");
+
+static __always_inline u64 xeu_gl_t(void)
+{
+	isb();
+	return read_sysreg(cntvct_el0);
+}
+
+static __always_inline void xeu_gl_load(struct xeu_gro_lat *l, int k, const void *p)
+{
+	u64 t0, v, ns;
+
+	dsb(ld);
+	t0 = xeu_gl_t();
+	v = READ_ONCE(*(const u64 *)p);
+	asm volatile("" : "+r" (v));
+	dsb(ld);
+	ns = xeu_gl_t() - t0;
+	l->n[k]++;
+	l->sum[k] += ns;
+	l->h[k][min_t(int, ilog2(ns | 1), 15)]++;
+}
+
+static void xeu_gro_lat_sample(struct napi_struct *napi, struct sk_buff *skb)
+{
+	struct xeu_gro_lat *l = this_cpu_ptr(&xeu_gro_lat);
+	struct gro_list *gl;
+	struct sk_buff *p, *last;
+
+	if (++l->tick < READ_ONCE(gro_lat_every))
+		return;
+	l->tick = 0;
+	l->sampled++;
+
+	WRITE_ONCE(l->own[0], l->sampled);
+	xeu_gl_load(l, 0, &l->own[0]);
+	xeu_gl_load(l, 1, (const void *)ALIGN_DOWN((unsigned long)skb->data + 64, 64));
+
+	gl = &napi->gro.hash[skb_get_hash_raw(skb) & (GRO_HASH_BUCKETS - 1)];
+	p = list_first_entry_or_null(&gl->list, struct sk_buff, list);
+	if (!p) {
+		l->none++;
+		return;
+	}
+	if (p->hash != skb->hash) {
+		l->other++;
+		return;
+	}
+	xeu_gl_load(l, 2, NAPI_GRO_CB(p));
+	xeu_gl_load(l, 3, (const void *)ALIGN_DOWN((unsigned long)p->data, 64));
+	xeu_gl_load(l, 4, skb_shinfo(p));
+	last = NAPI_GRO_CB(p)->last;
+	if (last && last != p)
+		xeu_gl_load(l, 5, skb_shinfo(last));
+}
+
+static int xeu_gro_lat_get(char *buf, const struct kernel_param *kp)
+{
+	static const char * const kn[XEU_GL_N] = {
+		"own", "hdr2", "agg_cb", "agg_hdr", "agg_shinfo", "last_shinfo" };
+	int cpu, k, b, len = 0;
+
+	for_each_possible_cpu(cpu) {
+		struct xeu_gro_lat *l = per_cpu_ptr(&xeu_gro_lat, cpu);
+
+		if (!l->sampled)
+			continue;
+		len += sysfs_emit_at(buf, len, "cpu%d sampled %llu none %llu other %llu\n",
+				     cpu, l->sampled, l->none, l->other);
+		for (k = 0; k < XEU_GL_N; k++) {
+			if (!l->n[k])
+				continue;
+			len += sysfs_emit_at(buf, len, "cpu%d %s n %llu sum_ns %llu h",
+					     cpu, kn[k], l->n[k], l->sum[k]);
+			for (b = 0; b < 16; b++)
+				len += sysfs_emit_at(buf, len, " %llu", l->h[k][b]);
+			len += sysfs_emit_at(buf, len, "\n");
+		}
+	}
+	return len;
+}
+
+static int xeu_gro_lat_set(const char *val, const struct kernel_param *kp)
+{
+	int cpu;
+
+	for_each_possible_cpu(cpu)
+		memset(per_cpu_ptr(&xeu_gro_lat, cpu), 0, sizeof(struct xeu_gro_lat));
+	return 0;
+}
+
+static const struct kernel_param_ops xeu_gro_lat_ops = {
+	.get = xeu_gro_lat_get,
+	.set = xeu_gro_lat_set,
+};
+module_param_cb(gro_lat, &xeu_gro_lat_ops, NULL, 0644);
+
 static bool rx_port_stats;
 module_param(rx_port_stats, bool, 0644);
 MODULE_PARM_DESC(rx_port_stats,
@@ -1235,6 +1365,8 @@
 		}
 
 		/* GRO receive */
+		if (READ_ONCE(gro_lat_every))
+			xeu_gro_lat_sample(napi, skb);
 		napi_gro_receive(napi, skb);
 		work_done++;
 
