 		 "prefetch the next received frame's headers, skb_shared_info and struct page while a frame is processed (default N)");
 
+/*
+ * Buffers smaller than a page come from page_pool_alloc_frag(), which
+ * charges a new page a bias of BIAS_MAX references and, when it moves on
+ * to the next page, takes back the part not handed out with an atomic on
+ * the page's pp_ref_count whose result it has to wait for.  On a recycled
+ * page that atomic is a miss on a line another CPU released the page
+ * through, and it was the rings' largest memory stall.  The ring knows how
+ * many pieces a page gives, so with this set it takes whole pages, sets
+ * the count to that number at once (a store) and keeps the page's pieces
+ * not yet posted for the next refill.  Read at each refill.
+ */
+static bool rx_page_split;
+module_param(rx_page_split, bool, 0644);
+MODULE_PARM_DESC(rx_page_split,
+		 "cut RX buffers from whole pages counted once, not through page_pool_alloc_frag() (default N)");
+
 static bool rx_port_stats;
 module_param(rx_port_stats, bool, 0644);
 MODULE_PARM_DESC(rx_port_stats,
@@ -696,11 +712,27 @@
 
