 		/* Allocate a page, or a piece of one, from the page pool */
-		if (buf_size < PAGE_SIZE)
+		if (rxr->split_left) {
+			/* A piece of the page cut last, counted already */
+			rx_page = rxr->split_page;
+			offset = rxr->split_offset;
+			rxr->split_offset += buf_size;
+			rxr->split_left--;
+		} else if (buf_size < PAGE_SIZE && READ_ONCE(rx_page_split)) {
+			rx_page = page_pool_alloc_pages(rxr->page_pool, GFP_ATOMIC);
+			if (likely(rx_page)) {
+				page_pool_fragment_page(rx_page, PAGE_SIZE / buf_size);
+				offset = 0;
+				rxr->split_page = rx_page;
+				rxr->split_offset = buf_size;
+				rxr->split_left = PAGE_SIZE / buf_size - 1;
+			}
+		} else if (buf_size < PAGE_SIZE) {
 			rx_page = page_pool_alloc_frag(rxr->page_pool, &offset,
 						       buf_size, GFP_ATOMIC);
-		else
+		} else {
 			rx_page = page_pool_alloc_pages(rxr->page_pool, GFP_ATOMIC);
+		}
 		if (unlikely(!rx_page)) {
 			if (net_ratelimit())
 				netdev_err(ring->dev, "Failed to allocate Rx page from pool\n");
@@ -1520,6 +1552,12 @@
 				  ring->sr_cons_idx,
 				  ring->sr_prod_idx - ring->sr_cons_idx);
 
+	/* And the pieces of a cut page not yet posted, one reference each */
+	while (rxr->split_left) {
+		page_pool_put_page(rxr->page_pool, rxr->split_page, -1, false);
+		rxr->split_left--;
