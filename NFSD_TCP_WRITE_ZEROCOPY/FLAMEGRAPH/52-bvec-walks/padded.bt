#!/usr/bin/bpftrace
/* The payloads the server decodes, other than the load's own 1 MiB: page mode
 * BVECS is a loaned record, and flag 8 says its table was not walked again. */
fentry:sunrpc:xdr_stream_subsegment /args.nbytes != 1048576/
{
	@sizes[args.xdr->buf->page_mode, args.xdr->buf->flags & 8, args.nbytes] = count();
}
