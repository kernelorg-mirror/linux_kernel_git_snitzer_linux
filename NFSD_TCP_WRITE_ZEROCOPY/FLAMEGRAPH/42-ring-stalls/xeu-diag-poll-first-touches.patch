+/*
+ * DIAGNOSTIC (FLAMEGRAPH round 42, not for keeping): the receive poll's
+ * first touches, timed by the 1 GHz counter read after ISB.  A load is
+ * timed with a DSB LD before and after it; a call is timed whole.
+ *   0 own          a line of this CPU's own, just written: the floor
+ *   1 cmpl_first   the completion at the head of a poll, when it is valid
+ *   2 cmpl_next    the next completion, where xeu_rx_prefetch_next() reads
+ *                  its valid bit (the first touch of every later one)
+ *   3 sw_entry     the frame's software ring entry
+ *   4 frame_page   the next frame's buffer's struct page, before the
+ *                  prefetch asks for it
+ *   5 pp_alloc     a call of page_pool_alloc_pages() (whole)
+ *   6 new_page     the struct page it returned, at its first load
+ *   7 doorbell     xeu_ring_db() after a refill (whole)
+ *   8 rearm        xeu_ring_irq_rearm() (whole)
+ *   9 frame_hdr    the next frame's first header line, before the
+ *                  prefetch asks for it
+ * 2, 3, 4 and 9 are the lines' state at their first touch: what the
+ * prefetch has to cover.
+ * The per-frame ones (2, 3, 4) and the allocations (5, 6) are timed on
+ * one in poll_lat_every; the per-poll ones (1, 7, 8) on every poll while
+ * it is not 0.  /sys/module/xeu/parameters/poll_lat prints n, sum_ns and a
+ * log2 histogram for each; a write clears.
+ */
+#define XEU_PL_N 10
+struct xeu_poll_lat {
+	u64 n[XEU_PL_N], sum[XEU_PL_N], h[XEU_PL_N][16];
+	unsigned int tick, atick;
+	u64 own[8] __aligned(64);
+};
+static DEFINE_PER_CPU(struct xeu_poll_lat, xeu_poll_lat);
+
+static unsigned int poll_lat_every;
+module_param(poll_lat_every, uint, 0644);
+MODULE_PARM_DESC(poll_lat_every, "DIAGNOSTIC: time the poll's first touches, per frame on one in this many (0: off)");
+
+static __always_inline u64 xeu_pl_t(void)
+{
+	isb();
+	return read_sysreg(cntvct_el0);
+}
+
+static __always_inline void xeu_pl_add(int k, u64 ns)
+{
+	struct xeu_poll_lat *l = this_cpu_ptr(&xeu_poll_lat);
+
+	l->n[k]++;
+	l->sum[k] += ns;
+	l->h[k][min_t(int, ilog2(ns | 1), 15)]++;
+}
+
+static __always_inline void xeu_pl_load(int k, const void *p)
+{
+	u64 t0, v;
+
+	dsb(ld);
+	t0 = xeu_pl_t();
+	v = READ_ONCE(*(const u64 *)p);
+	asm volatile("" : "+r" (v));
+	dsb(ld);
+	xeu_pl_add(k, xeu_pl_t() - t0);
+}
+
+static __always_inline bool xeu_pl_frame(void)
+{
+	struct xeu_poll_lat *l;
+	unsigned int every = READ_ONCE(poll_lat_every);
+
+	if (likely(!every))
+		return false;
+	l = this_cpu_ptr(&xeu_poll_lat);
+	if (++l->tick < every)
+		return false;
+	l->tick = 0;
+	WRITE_ONCE(l->own[0], l->n[0]);
+	xeu_pl_load(0, &l->own[0]);
+	return true;
+}
+
+static __always_inline bool xeu_pl_alloc(void)
+{
+	struct xeu_poll_lat *l;
+	unsigned int every = READ_ONCE(poll_lat_every);
+
+	if (likely(!every))
+		return false;
+	l = this_cpu_ptr(&xeu_poll_lat);
+	if (++l->atick < every)
+		return false;
+	l->atick = 0;
+	return true;
+}
+
+static int xeu_poll_lat_get(char *buf, const struct kernel_param *kp)
+{
+	static const char * const kn[XEU_PL_N] = {
+		"own", "cmpl_first", "cmpl_next", "sw_entry", "frame_page",
+		"pp_alloc", "new_page", "doorbell", "rearm", "frame_hdr" };
+	int cpu, k, b, len = 0;
+
+	for_each_possible_cpu(cpu) {
+		struct xeu_poll_lat *l = per_cpu_ptr(&xeu_poll_lat, cpu);
+
+		for (k = 0; k < XEU_PL_N; k++) {
+			if (!l->n[k])
+				continue;
+			len += sysfs_emit_at(buf, len, "cpu%d %s n %llu sum_ns %llu h",
+					     cpu, kn[k], l->n[k], l->sum[k]);
+			for (b = 0; b < 16; b++)
+				len += sysfs_emit_at(buf, len, " %llu", l->h[k][b]);
+			len += sysfs_emit_at(buf, len, "\n");
+		}
+	}
+	return len;
+}
+
+static int xeu_poll_lat_set(const char *val, const struct kernel_param *kp)
+{
+	int cpu;
+
+	for_each_possible_cpu(cpu)
+		memset(per_cpu_ptr(&xeu_poll_lat, cpu), 0, sizeof(struct xeu_poll_lat));
+	return 0;
+}
+
+static const struct kernel_param_ops xeu_poll_lat_ops = {
+	.get = xeu_poll_lat_get,
+	.set = xeu_poll_lat_set,
+};
+module_param_cb(poll_lat, &xeu_poll_lat_ops, NULL, 0644);
+
