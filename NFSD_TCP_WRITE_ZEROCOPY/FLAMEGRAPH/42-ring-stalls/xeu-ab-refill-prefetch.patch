+/*
+ * Take up to @n pages for a refill from @pool into @pages, prefetching each
+ * struct page for writing when rx_refill_prefetch is set.  Returns the
+ * number taken; fewer than @n only when the pool has no more.
+ */
+static unsigned int xeu_rx_take_pages(struct page_pool *pool,
+				      struct page **pages, unsigned int n)
+{
+	const bool pf = READ_ONCE(rx_refill_prefetch);
+	unsigned int j;
+
+	for (j = 0; j < n; j++) {
+		pages[j] = page_pool_alloc_pages(pool, GFP_ATOMIC);
+		if (unlikely(!pages[j]))
+			break;
+		if (pf)
+			prefetchw(pages[j]);
+	}
+	return j;
+}
