 /*
+ * A page the refill takes from the page pool was last written where it was
+ * freed, mostly on another CPU, and its struct page comes from the L3:
+ * the refill's first store to it (the fragment count) and load (its DMA
+ * address) wait for it, one page at a time.  With this set, the refill
+ * takes the pages it needs, up to XEU_RX_REFILL_BATCH at a time, and
+ * prefetches each struct page for writing before posting any, so the
+ * misses overlap.  The pages, their number and their order are the same
+ * either way.
+ */
+#define XEU_RX_REFILL_BATCH 16
+static bool rx_refill_prefetch;
+module_param(rx_refill_prefetch, bool, 0644);
+MODULE_PARM_DESC(rx_refill_prefetch, "prefetch the struct pages a refill takes before posting them (default N)");
+/*
