 }
 
+static noinline int xeu_ep_poll(struct napi_struct *napi, int budget)
+{
+	struct xeu_ring *ring = container_of(napi, struct xeu_ring, napi);
+	struct xeu_empty_lat *l = this_cpu_ptr(&xeu_empty_lat);
+	bool irq = l->irq_ring == ring && l->irq_t;
+	bool after_work = l->unmask_after_work, spun = false, valid;
+	u64 t0 = xeu_ep_t(), irq_t = l->irq_t, t1;
+	int done;
+
+	l->irq_ring = NULL;
+	l->irq_t = 0;
+	l->cnt[irq ? EC_POLL_IRQ : EC_POLL_RE]++;
+	if (irq)
+		xeu_ep_add(l, EP_IRQ_TO_POLL, t0 - irq_t);
+	valid = RX_CMPL_VALID(ring, ring->cr_cons_idx);
+	if (irq && l->unmask_ring == ring && l->unmask_t && irq_t > l->unmask_t) {
+		xeu_ep_add(l, valid ? EP_UNMASK_WORK : EP_UNMASK_EMPTY, irq_t - l->unmask_t);
+		if (!valid)
+			xeu_ep_add(l, after_work ? EP_UNMASK_EMPTY_W : EP_UNMASK_EMPTY_ZW,
+				   irq_t - l->unmask_t);
+	}
+	l->unmask_t = 0;
+	if (!valid) {
+		l->cnt[irq ? EC_EMPTY_IRQ : EC_EMPTY_RE]++;
+		if (l->tick++ & 1) {
+			spun = true;
+			while (!RX_CMPL_VALID(ring, ring->cr_cons_idx) &&
+			       xeu_ep_t() - t0 < 4000)
+				cpu_relax();
+			if (RX_CMPL_VALID(ring, ring->cr_cons_idx))
+				xeu_ep_add(l, irq ? EP_WAIT_IRQ : EP_WAIT_RE, xeu_ep_t() - t0);
+			else
+				l->cnt[irq ? EC_NEVER_IRQ : EC_NEVER_RE]++;
+		}
+	}
+	done = __xeu_rx_poll(napi, budget);
+	t1 = xeu_ep_t();
+	l->cnt[EC_FRAMES] += done;
+	if (done >= budget)
+		l->cnt[EC_BUDGET]++;
+	if (valid) {
+		xeu_ep_add(l, EP_WORK_POLL, t1 - t0);
+	} else if (!spun) {
+		xeu_ep_add(l, irq ? EP_EMPTY_POLL_IRQ : EP_EMPTY_POLL_RE, t1 - t0);
+		if (irq)
+			xeu_ep_add(l, EP_EMPTY_IRQ_WHOLE, t1 - irq_t);
+	}
+	return done;
+}
+
+static int xeu_rx_poll(struct napi_struct *napi, int budget)
+{
+	if (unlikely(READ_ONCE(empty_lat_on)))
+		return xeu_ep_poll(napi, budget);
+	return __xeu_rx_poll(napi, budget);
+}
+
 
