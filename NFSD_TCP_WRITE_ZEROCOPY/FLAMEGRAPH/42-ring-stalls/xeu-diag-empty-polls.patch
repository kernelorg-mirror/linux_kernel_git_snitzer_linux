-static int xeu_rx_poll(struct napi_struct *napi, int budget)
+static int __xeu_rx_poll(struct napi_struct *napi, int budget)
 {
 	u16 expected_vlan_id, rx_fill_cnt, sub_idx, error_status, hw_pkt_format;
 	u32 num_of_frags, total_len, linear_len, frag_idx, frag_len;
@@ -1356,12 +1497,73 @@
 			ring->xeu_dev->interrupt_rx[ring->sw_ring_idx] = false;
 #endif
 			xeu_ring_irq_rearm(ring);
+			if (unlikely(READ_ONCE(empty_lat_on)))
+				xeu_ep_unmask(ring, work_done);
+		} else if (unlikely(READ_ONCE(empty_lat_on))) {
