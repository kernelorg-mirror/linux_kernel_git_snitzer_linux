+/*
+ * DIAGNOSTIC (FLAMEGRAPH round 38, not for keeping): where in the release's
+ * loop its struct page misses fall.  Timed by the 1 GHz counter read after
+ * ISB, each load drained (DSB LD) before and after, as round 36's:
+ *   - the first load of each page's first word, by the page's ordinal in
+ *     the release (the k-th distinct page): slots 0 to 15 one ordinal each,
+ *     16 the ordinals 16 to 31, 17 32 to 63, 18 64 and on;
+ *   - slot 19, the same timings again for the entries at or past
+ *     SVC_TCP_RX_PUT_BATCH, whose page was prefetched a batch ahead (the
+ *     earlier ones were prefetched just before the loop);
+ *   - slot 20, the load of the bvec entry a batch ahead whose page the loop
+ *     prefetches, when that entry starts a cache line;
+ *   - slot 21, a line of the CPU's own (the floor).
+ * Each release adds its entries and distinct pages to the counts.  Summed
+ * over CPUs when read, so nothing is cut at the parameter's page.
+ * svc_tcp_rx_diag_rel turns it on; svc_tcp_rx_rel_lat prints, a write
+ * clears.  The barriers add time to every entry, so later entries gain lead
+ * they would not have untimed; ordinal 0's lead is the loop's own.
+ */
+#define SVC_TCP_RX_REL_SLOTS	22
+static bool svc_tcp_rx_diag_rel __read_mostly;
+module_param(svc_tcp_rx_diag_rel, bool, 0644);
+
+struct svc_tcp_rx_rel_slot {
+	u64 n, sum, h[16];
+};
+
+struct svc_tcp_rx_rel_lat {
+	struct svc_tcp_rx_rel_slot s[SVC_TCP_RX_REL_SLOTS];
+	u64 releases, entries, pages;
+	unsigned long own __aligned(64);
+} __aligned(64);
+static DEFINE_PER_CPU(struct svc_tcp_rx_rel_lat, svc_tcp_rx_rel_lat);
+
+static __always_inline u64 svc_tcp_rx_rel_t(void)
+{
+	isb();
+	return read_sysreg(cntvct_el0);
+}
+
+static __always_inline u64 svc_tcp_rx_rel_time(const void *p)
+{
+	u64 t0;
+
+	dsb(ld);
+	t0 = svc_tcp_rx_rel_t();
+	(void)READ_ONCE(*(const unsigned long *)p);
+	dsb(ld);
+	return svc_tcp_rx_rel_t() - t0;
+}
+
+static void svc_tcp_rx_rel_add(struct svc_tcp_rx_rel_lat *l, int k, u64 ns)
+{
+	struct svc_tcp_rx_rel_slot *s = &l->s[k];
+
+	s->n++;
+	s->sum += ns;
+	s->h[min_t(int, ilog2(ns | 1), 15)]++;
+}
+
+static int svc_tcp_rx_rel_ordinal_slot(unsigned int ord)
+{
+	if (ord < 16)
+		return ord;
+	if (ord < 32)
+		return 16;
+	return ord < 64 ? 17 : 18;
+}
+
+static int svc_tcp_rx_rel_lat_get(char *buf, const struct kernel_param *kp)
+{
+	static const char * const tail[] = { "ord16-31", "ord32-63", "ord64+",
+					     "entry_past_batch", "bvec_ahead",
+					     "own" };
+	struct svc_tcp_rx_rel_slot t[SVC_TCP_RX_REL_SLOTS] = {};
+	u64 releases = 0, entries = 0, pages = 0;
+	int cpu, k, b, len = 0;
+
+	for_each_possible_cpu(cpu) {
+		struct svc_tcp_rx_rel_lat *l =
+			per_cpu_ptr(&svc_tcp_rx_rel_lat, cpu);
+
+		releases += l->releases;
+		entries += l->entries;
+		pages += l->pages;
+		for (k = 0; k < SVC_TCP_RX_REL_SLOTS; k++) {
+			t[k].n += l->s[k].n;
+			t[k].sum += l->s[k].sum;
+			for (b = 0; b < 16; b++)
+				t[k].h[b] += l->s[k].h[b];
+		}
+	}
+	len += sysfs_emit_at(buf, len, "releases %llu entries %llu pages %llu\n",
+			     releases, entries, pages);
+	for (k = 0; k < SVC_TCP_RX_REL_SLOTS; k++) {
+		if (k < 16)
+			len += sysfs_emit_at(buf, len, "ord%d", k);
+		else
+			len += sysfs_emit_at(buf, len, "%s", tail[k - 16]);
+		len += sysfs_emit_at(buf, len, " n %llu sum_ns %llu h",
+				     t[k].n, t[k].sum);
+		for (b = 0; b < 16; b++)
+			len += sysfs_emit_at(buf, len, " %llu", t[k].h[b]);
+		len += sysfs_emit_at(buf, len, "\n");
+	}
+	return len;
+}
+
+static int svc_tcp_rx_rel_lat_set(const char *val,
+				  const struct kernel_param *kp)
+{
+	int cpu;
+
+	for_each_possible_cpu(cpu) {
+		struct svc_tcp_rx_rel_lat *l =
+			per_cpu_ptr(&svc_tcp_rx_rel_lat, cpu);
+
+		memset(l->s, 0, sizeof(l->s));
+		l->releases = l->entries = l->pages = 0;
+	}
+	return 0;
+}
+
+static const struct kernel_param_ops svc_tcp_rx_rel_lat_ops = {
+	.get = svc_tcp_rx_rel_lat_get,
+	.set = svc_tcp_rx_rel_lat_set,
+};
+module_param_cb(svc_tcp_rx_rel_lat, &svc_tcp_rx_rel_lat_ops, NULL, 0644);
